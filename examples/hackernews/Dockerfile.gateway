# Stateless public UI; the managed Antfly instance runs separately.
ARG BASE_IMAGE=python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY examples/hackernews/serve.py examples/hackernews/managed_api.py ./
COPY examples/hackernews/web ./web
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["python3", "/app/serve.py", "--host", "0.0.0.0"]
