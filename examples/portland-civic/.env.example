ANTFLY_URL=http://127.0.0.1:8088
PORT=3007
# Credentials stay in the server process. For a secured Antfly instance:
# ANTFLY_USERNAME=admin
# ANTFLY_PASSWORD=...
# Optional semantic indexes (set before ingest and governance:ingest; runs in Antfly):
# ANTFLY_EMBEDDER={"provider":"ollama","model":"embeddinggemma","url":"http://localhost:11434"}
# With Antfly's local model installed:
# ANTFLY_EMBEDDER={"provider":"antfly","model":"antflydb/clipclap","api_url":"http://127.0.0.1:8088"}
# Optional cited generation for the permit app:
# ANTFLY_GENERATOR={"provider":"ollama","model":"gemma3:4b","url":"http://localhost:11434"}

# Governance uses a dedicated native inference server and Qwen3-Embedding.
GOVERNANCE_INFERENCE_URL=http://127.0.0.1:8091
GOVERNANCE_EXTRACTION_MODEL=antflydb/gliner2-base-v1
GOVERNANCE_EXTRACTION_SCHEMA_VERSION=1
# Later, a qualified GLiNER2.5 build can use fastino/gliner2.5-base-v1 and schema 2.
# Default generator: local Gemma 4. Antfly's generator expects /ai/v1 here.
# GOVERNANCE_GENERATOR={"provider":"antfly","model":"ggml-org/gemma-4-E4B-it-GGUF","api_url":"http://127.0.0.1:8091/ai/v1","max_tokens":1024,"temperature":0}
# Hosted alternative: set OPENAI_API_KEY in the Antfly DATABASE SERVER process.
# No automatic hosted fallback occurs. Passage text is sent to this provider.
# GOVERNANCE_GENERATOR={"provider":"openai","model":"gpt-5.6-luna","max_tokens":1500}
