package antfly:extension@0.1.0;

interface db {
  query: func(table: string, query-json: string) -> result<string, string>;
  write: func(table: string, writes-json: string) -> result<string, string>;
}

interface ai {
  embed: func(model: string, text: string) -> result<list<float32>, string>;
}

interface mcp {
  tool-result: record {
    content-json: string,
  }
}

world extension {
  import db;
  import ai;

  export init: func(config-json: string) -> result<_, string>;
  export call-tool: func(name: string, request-json: string) -> result<mcp.tool-result, string>;
}
