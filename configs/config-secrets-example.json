{
  "deployment_mode": "standalone",
  "storage": {
    "engine": "local",
    "local": { "base_dir": "/var/lib/antfly" }
  },
  "connections": {
    "openai-production": {
      "kind": "inference",
      "capabilities": ["models.generate", "models.embed"],
      "inference": {
        "provider": "openai",
        "url": "https://api.openai.com/v1",
        "api_key": "${secret:openai.api_key}",
        "names": ["primary-generator", "primary-embedder"],
        "configured_model_types": ["generator", "embedder"]
      }
    }
  },
  "remote_content": {
    "default_s3": "customer-documents",
    "s3": {
      "customer-documents": {
        "region": "us-west-2",
        "access_key_id": "${secret:content.aws_access_key_id}",
        "secret_access_key": "${secret:content.aws_secret_access_key}",
        "buckets": ["customer-documents"]
      }
    },
    "http": {
      "internal-api": {
        "base_url": "https://docs.internal.example.com",
        "headers": { "Authorization": "${secret:content.internal_api_authorization}" }
      }
    },
    "security": {
      "block_private_ips": true,
      "max_download_size_bytes": 104857600,
      "download_timeout_seconds": 30,
      "max_image_dimension": 2048
    }
  },
  "log": { "level": "info", "style": "json" }
}
