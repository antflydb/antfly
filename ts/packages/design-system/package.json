{
  "name": "@antfly/design-system",
  "version": "0.3.0",
  "description": "Antfly's shared shadcn/ui component library: primitives, compound components, brand blocks, design tokens, and Aeonik.",
  "author": "Antfly, Inc. <contact@antfly.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antflydb/antfly.git",
    "directory": "ts/packages/design-system"
  },
  "keywords": [
    "antfly",
    "design-system",
    "shadcn",
    "ui",
    "react",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/fonts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./tokens": {
      "style": "./dist/tokens/index.css",
      "default": "./dist/tokens/index.css"
    },
    "./theme": {
      "style": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./base.css": {
      "style": "./dist/base.css",
      "default": "./dist/base.css"
    },
    "./dashboard.css": {
      "style": "./dist/dashboard.css",
      "default": "./dist/dashboard.css"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./charts.css": {
      "style": "./dist/charts.css",
      "default": "./dist/charts.css"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    },
    "./examples": {
      "types": "./dist/examples/index.d.ts",
      "import": "./dist/examples/index.js"
    },
    "./fonts/*": "./src/fonts/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:components && pnpm run build:fonts && pnpm run build:styles && pnpm run build:css-assets",
    "build:components": "vite build",
    "build:fonts": "mkdir -p dist/fonts && cp -R src/fonts/aeonik dist/fonts/",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:css-assets": "mkdir -p dist/tokens/fonts && cp -R src/tokens/* dist/tokens/ && cp -R src/fonts/aeonik dist/tokens/fonts/ && cp src/theme.css dist/theme.css && cp src/base.css dist/base.css && cp src/charts.css dist/charts.css && cp src/dashboard.css dist/dashboard.css",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run build:styles --watch",
    "clean": "rm -rf dist",
    "lint": "biome lint src"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tailwindcss": "^4.3.1",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
