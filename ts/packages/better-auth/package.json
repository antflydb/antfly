{
  "name": "@antfly/better-auth",
  "version": "0.1.0-rc.1",
  "description": "Better Auth adapter and user-scoped content for Antfly",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    }
  },
  "bin": {
    "antfly-auth": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run test/contracts.test.ts test/workers.test.ts test/workers-upstream.test.ts",
    "lint": "biome check .",
    "test:integration": "vitest run --maxWorkers=1 test/integration.test.ts test/upstream.test.ts",
    "test:remote": "vitest run --maxWorkers=1 test/remote.test.ts test/upstream.test.ts",
    "test:workers": "vitest run --maxWorkers=1 test/workers.test.ts test/workers-upstream.test.ts"
  },
  "dependencies": {
    "@antfly/sdk": "workspace:^0.2.2",
    "@better-auth/core": "~1.7.14"
  },
  "peerDependencies": {
    "better-auth": "~1.7.14",
    "@antfly/embedded": "^0.3.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@antfly/embedded": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-auth": "1.7.14",
    "@better-auth/test-utils": "1.7.14",
    "@antfly/embedded": "workspace:*",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antflydb/antfly.git",
    "directory": "ts/packages/better-auth"
  },
  "keywords": [
    "antfly",
    "better-auth",
    "authentication",
    "embedded",
    "search"
  ]
}
