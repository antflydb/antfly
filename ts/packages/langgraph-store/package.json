{
  "name": "@antfly/langgraph-store",
  "version": "0.1.0",
  "description": "Persistent Antfly long-term memory for LangGraph.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "VALIDATION.md",
    "validation"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "lint": "biome check .",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@antfly/sdk": "workspace:^",
    "@antfly/langchain": "workspace:^",
    "@langchain/langgraph-checkpoint": "^1.2.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.3.0 <2",
    "@langchain/langgraph": ">=1.5.3 <2"
  },
  "devDependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/classic": "1.0.56",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9",
    "@langchain/openai": "1.7.1",
    "@langchain/langgraph": "1.5.3"
  },
  "engines": {
    "node": ">=24.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antflydb/antfly.git",
    "directory": "ts/packages/langgraph-store"
  },
  "publishConfig": {
    "access": "public"
  }
}
