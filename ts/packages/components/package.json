{
  "name": "@antfly/components",
  "version": "0.0.14",
  "description": "React components for Antfly search",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/adapters.cjs"
    },
    "./styles": "./dist/components.css"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "storybook": "sb dev",
    "build-storybook": "sb build",
    "clean": "rm -rf dist types",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "antfly",
    "react",
    "search",
    "components",
    "facets",
    "rag"
  ],
  "author": "Antfly Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antflydb/antfly.git",
    "directory": "ts/packages/components"
  },
  "bugs": {
    "url": "https://github.com/antflydb/antfly/issues"
  },
  "homepage": "https://github.com/antflydb/antfly/tree/main/ts/packages/components#readme",
  "browserslist": [
    ">0.03%"
  ],
  "peerDependencies": {
    "@antfly/sdk": "workspace:*",
    "react": "^16.0.0 || ^17.0 || ^18.0 || ^19.0",
    "react-dom": "^16.0 || ^17.0 || ^18.0 || ^19.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "qs": "^6.15.2",
    "react-autosuggest": "^10.1.0"
  },
  "devDependencies": {
    "@antfly/sdk": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@storybook/addon-docs": "10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-autosuggest": "^10.1.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "core-js": "^3.49.0",
    "jsdom": "^29.1.1",
    "lodash": "4.18.1",
    "msw": "^2.14.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sb": "^10.4.5",
    "storybook": "^10.4.5",
    "streamdown": "^2.5.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  }
}
