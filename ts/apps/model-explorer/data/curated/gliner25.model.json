{
  "id": "gliner25",
  "family": "gliner",
  "displayName": "GLiNER2.5 Base",
  "tagline": "GLiNER2's successor. Instead of scoring every possible span, it proposes span boundaries and lets each field in the schema score one shared pool of candidates — classifying, relating and building records in the same pass. The base variant now serves in the runtime, gated by a published qualification table.",
  "stats": {
    "layers": 12,
    "hidden": 768,
    "vocab": 128011,
    "relBuckets": 256,
    "maxBodyWords": 4096,
    "boundaryDim": 128,
    "poolSize": 192,
    "poolProposals": "top-32 starts × ends",
    "promptMarkers": 10,
    "variants": "small 74M · base 194M · multi 287M",
    "quant": "FP32 heads; encoder FP16/Q8_0/Q4_K",
    "tokenizer": "SentencePiece Unigram + strict normalizer",
    "scope": "Serving is qualified for the base-v1 bundles (f32 and fp16-encoder) on native and Metal, within pinned single-window and long-document length contracts; other variants and quantized-encoder bundles are not in the table. Diagrams are schematic, not qualification evidence."
  },
  "stages": [
    {
      "kind": "embedding",
      "id": "embed",
      "title": "Prompt + text embedding",
      "spine": "graph",
      "summary": "The serialized schema prompt — ten marker types, group headers, descriptions, few-shot examples and synthetic enum-prefix words — is embedded in the same pass as the text. No absolute position embeddings.",
      "source": {
        "path": "zig/pkg/inference/src/pipelines/gliner_boundary_processor.zig"
      }
    },
    {
      "kind": "encoder",
      "id": "encoder",
      "title": "DeBERTa encoder layer",
      "spine": "graph",
      "attention": "disentangled_relative",
      "summary": "The same DeBERTa-v3 disentangled relative attention as GLiNER2, with hard-pinned geometry. On Metal it runs as a single simdgroup dispatch of the boundary mega-kernel (Kind.deberta_attention); a native FP32 path is the reference.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner/boundary_engine_device.zig"
      },
      "repeat": {
        "count": 12,
        "note": "12 layers with the same structure and distinct learned weights; diagram shows one layer"
      }
    },
    {
      "kind": "head",
      "id": "boundary",
      "title": "Boundary encoder + proposer",
      "spine": "graph",
      "headType": "span",
      "summary": "Word states project into a 128-d boundary space over W+1 positions (learned BOS/EOS states), refined by windowed self-attention and a gated FFN; the query-union of start/end marginals proposes the document's top-32 boundary starts and ends.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner/boundary_head.zig"
      }
    },
    {
      "kind": "pooling",
      "id": "pool",
      "title": "Shared candidate pool",
      "spine": "graph",
      "method": "shared candidate pool (192 slots), FiLM-conditioned per query",
      "summary": "Proposals from every query merge into one document-level pool of 192 candidate spans (at least 8 per query). Each query scores the same pool through its own FiLM conditioning — adding labels reuses the pool instead of re-enumerating spans.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner/boundary_head.zig"
      }
    },
    {
      "kind": "head",
      "id": "scorer",
      "title": "Pair scorer + abstention + count",
      "spine": "graph",
      "headType": "span",
      "summary": "Shared-pool logits from the FiLM scorer drive entity and field decoding. A separate explicit-span scorer — rotary endpoints, an 8-head compatibility mix, endpoint differences, inside evidence — scores attributes and constrained/enum fields. A null projection lets each query abstain; a count head predicts expected counts.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner/boundary_head.zig"
      }
    },
    {
      "kind": "head",
      "id": "tasks",
      "title": "Classification / relations / records",
      "spine": "graph",
      "headType": "classifier",
      "summary": "Three more heads read the same encoded sequence: an MLP on each [L] choice-marker state for classification, a biaffine-content relation scorer, and a record decoder that seeds instances from anchor candidates (or 32 learned queries in anchorless mode).",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner/boundary_tasks.zig"
      }
    }
  ],
