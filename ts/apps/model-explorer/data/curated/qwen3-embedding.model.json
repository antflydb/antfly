      "kind": "embedding",
      "id": "kv",
      "title": "Temporary attention K/V",
      "spine": "graph",
      "summary": "Dense causal attention consumes temporary K/V tensors. Eligible kernels stage them as f16; embedding requests do not retain a paged cache for later decoding."
    },
    {
      "kind": "pooling",
      "id": "pool",
      "title": "Last-token pooling",
      "spine": "graph",
      "method": "last-token",
      "summary": "Last-token pooling selects the final non-padding hidden row of each batch item. The pipeline ensures EOS occupies that position after configured truncation.",
      "source": {
