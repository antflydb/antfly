    "layers": 12,
    "hidden": 768,
    "heads": 12,
    "ffn": 3072,
    "vocab": 128011,
    "context": 512,
    "relBuckets": 256,
    "maxSpanWidth": 12,
    "quant": "Q4_K",
    "tokenizer": "SentencePiece",
    "scope": "Base entity-extraction example; other GLiNER2 tasks use additional heads and pipeline logic"
  },
  "stages": [
    {
      "kind": "embedding",
      "id": "embed",
      "title": "Token embedding",
      "spine": "graph",
      "summary": "SentencePiece ids gather embedding rows; padded positions are zeroed by the embedding mask. No absolute position embeddings are added — position lives entirely inside attention."
    },
    {
      "kind": "encoder",
      "id": "encoder",
      "title": "DeBERTa encoder layer",
      "spine": "graph",
      "attention": "disentangled_relative",
      "summary": "Bidirectional encoder: no causal mask, no KV cache, no sampling. Attention scores decompose into content-to-content, content-to-position, and position-to-content terms.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/deberta_graph.zig",
        "anchor": "pub fn buildForwardGraph("
      },
      "repeat": {
        "count": 12,
        "note": "12 layers with the same structure and distinct learned weights; diagram shows one layer"
      }
    },
    {
      "kind": "head",
      "id": "head",
      "title": "Span head",
      "spine": "graph",
      "headType": "span",
      "summary": "First-subtoken word features and entity-marker label features feed span and label heads. Sigmoid scores are thresholded, then flat NER filters overlapping spans.",
      "source": {
        "path": "zig/pkg/inference/src/architectures/gliner_head.zig",
        "anchor": "fn extractWordEmbeddings("
      }
    }
  ],
