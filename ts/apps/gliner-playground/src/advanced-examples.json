{
  "mixed_tasks": {
    "schema_version": 2,
    "model": "fastino/gliner2.5-small-v1",
    "inputs": [
      {
        "content": "John works at Apple. Alice works at Google."
      }
    ],
    "schema": {
      "entities": ["person", "organization"],
      "classifications": [
        {
          "name": "sentiment",
          "labels": ["positive", "negative"]
        }
      ],
      "relations": [
        {
          "type": "works_for"
        }
      ]
    },
    "options": {
      "include_confidence": true,
      "include_spans": true,
      "offset_unit": "utf16_codeunits"
    }
  },
  "entity_attributes": {
    "schema_version": 2,
    "model": "fastino/gliner2.5-small-v1",
    "inputs": [
      {
        "content": "The iPhone camera is good. The battery is bad."
      }
    ],
    "schema": {
      "entities": ["product"],
      "entity_attributes": {
        "sentiment": {
          "labels": ["positive", "negative", "neutral"],
          "applies_to": ["product"],
          "qualify_labels": true
        },
        "condition": {
          "labels": ["working", "broken"],
          "multi_label": true,
          "threshold": 0.5,
          "qualify_labels": true
        }
      }
    },
    "options": {
      "include_confidence": true,
      "include_spans": true,
      "offset_unit": "utf16_codeunits"
    }
  },
  "constrained_classification": {
    "schema_version": 2,
    "model": "fastino/gliner2.5-small-v1",
    "inputs": [
      {
        "content": "Delete the temporary file."
      }
    ],
    "schema": {
      "classifications": [
        {
          "name": "intent",
          "labels": ["read", "delete"],
          "min_labels": 1,
          "max_labels": 1
        },
        {
          "name": "effects",
          "labels": ["read_only", "delete"],
          "min_labels": 1,
          "max_labels": 1
        }
      ],
      "classification_constraints": [
        {
          "type": "Implies",
          "cond": {
            "type": "LabelRef",
            "task": "intent",
            "label": "delete"
          },
          "then": {
            "type": "LabelRef",
            "task": "effects",
            "label": "delete"
          }
        }
      ]
    },
    "options": {
      "include_confidence": true,
      "include_spans": true,
      "offset_unit": "utf16_codeunits"
    }
  },
  "joint_ie": {
    "schema_version": 2,
    "model": "fastino/gliner2.5-small-v1",
    "inputs": [
      {
        "content": "John works at Apple. Alice works at Google."
      }
    ],
    "schema": {
      "joint_ie": {
        "entities": {
          "person": {},
          "organization": {}
        },
        "relations": {
          "works_for": {
            "head": ["person"],
            "tail": ["organization"],
            "max_per_head": 1
          }
        }
      }
    },
    "options": {
      "include_confidence": true,
      "include_spans": true,
      "offset_unit": "utf16_codeunits"
    }
  }
}
