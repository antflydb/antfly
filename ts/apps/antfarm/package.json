{
  "name": "antfarm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-command-index.mjs --check && tsc -b && vite build",
    "test": "vitest run --project unit",
    "typecheck": "node scripts/sync-command-index.mjs --check && tsc -b",
    "generate": "node scripts/sync-command-index.mjs",
    "generate:commands": "node scripts/sync-command-index.mjs",
    "check:commands": "node scripts/sync-command-index.mjs --check",
    "update-deps": "npx npm-check-updates -u && npm install",
    "lint": "biome check . --write --unsafe",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook"
  },
  "dependencies": {
