{
  "provider": "nessie",
  "catalog_uri": "https://lake.example.com/catalog",
  "upstream_uri": "http://nessie:19120/iceberg",
  "nessie_uri": "http://nessie:19120/api/v2",
  "warehouse": "warehouse",
  "warehouse_uri": "s3://warehouse/nessie/",
  "authority_uri": "s3://warehouse/controllers/nessie/",
  "artifact_uri": "s3://warehouse/artifacts/",
  "artifact_connection": "qualification",
  "gateway_enforced": true,
  "upstream_headers": {},
  "io_properties": {
    "s3.endpoint": "http://s3:9000",
    "s3.region": "us-west-2",
    "s3.access-key-id": {
      "env": "S3_ACCESS_KEY"
    },
    "s3.secret-access-key": {
      "env": "S3_SECRET_KEY"
    }
  },
  "tokens": {
    "admin": {
      "env": "ANTFLY_ADMIN_TOKEN"
    },
    "writer": {
      "env": "ANTFLY_WRITER_TOKEN"
    },
    "native": {
      "env": "ANTFLY_NATIVE_TOKEN"
    }
  }
}
