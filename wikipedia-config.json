{
  "indexes": {
    "title_body": {
      "name": "title_body",
      "type": "embeddings",
      "template": "{{title}} {{body}}",
      "embedder": {
        "provider": "antfly",
        "model": "google/embeddinggemma-2:bf16-safetensors-bundle-v1"
      },
      "chunker": {
        "provider": "antfly",
        "text": {
          "target_tokens": 200,
          "overlap_tokens": 25
        }
      }
    },
    "thumbnail": {
      "name": "thumbnail",
      "type": "embeddings",
      "template": "{{media url=thumbnail_url}}",
      "embedder": {
        "provider": "antfly",
        "model": "google/embeddinggemma-2:bf16-safetensors-bundle-v1"
      },
      "dimension": 768,
      "distance_metric": "cosine"
    }
  }
}
