+test "warm hints preserve caller order contract without changing accepted row trace" {
+    var clock = TestClock{};
+    var fake = FakeSolver{};
+    const matrix = [_]f64{ 1, 1, 1, 1 };
+    const warm = [_]usize{ 3, 1 };
+    var result = try solvePrimaryConstraintGeneration(
+        std.testing.allocator,
+        &matrix,
+        4,
+        1,
+        &warm,
+        1000,
+        clock.control(),
+        fake.interface(),
+    );
+    defer result.deinit();
+    switch (result) {
+        .accepted => |accepted| {
+            try std.testing.expectEqual(@as(usize, 2), accepted.diagnostics.warm_hint_rows);
+            try std.testing.expectEqual(@as(usize, 0), accepted.diagnostics.rounds[0].added_rows);
+            try std.testing.expectEqual(@as(usize, 4), accepted.diagnostics.selected_rows);
+        },
+        .terminal => return error.UnexpectedTerminal,
+    }
+}
+
+const AddedThenTerminalSolver = struct {
+    calls: usize = 0,
+    fn solve(raw: ?*anyopaque, allocator: std.mem.Allocator, problem: *const mass_lp.Problem, _: u64, control: Control, _: f64) !RestrictedSolve {
+        const self: *AddedThenTerminalSolver = @ptrCast(@alignCast(raw.?));
+        try control.check();
+        self.calls += 1;
+        if (problem.weight_columns != 1) return error.UnexpectedSolveShape;
+        if (self.calls == 1) {
+            const weights = try allocator.alloc(f64, 1);
+            errdefer allocator.free(weights);
+            weights[0] = 1;
+            const duals = try allocator.alloc(f64, 2 * problem.source_rows);
+            @memset(duals, 0);
+            return .{ .allocator = allocator, .status = .optimal, .weights = weights, .t = 0, .objective = 0, .row_duals = duals, .iterations = 2 };
+        }
+        const weights = try allocator.alloc(f64, 0);
+        errdefer allocator.free(weights);
+        const duals = try allocator.alloc(f64, 0);
+        return .{ .allocator = allocator, .status = .time_limit, .weights = weights, .t = 0, .objective = 0, .row_duals = duals, .iterations = 0 };
+    }
+};
+test "terminal after an added-row round retains exact completed row trace" {
+    var clock = TestClock{};
+    var fake = AddedThenTerminalSolver{};
+    var matrix: [seed_rows + 2]f64 = @splat(1);
+    var seeded: [seed_rows + 2]bool = @splat(false);
+    try seedSelection(&seeded);
+    var violated_row: ?usize = null;
+    for (seeded, 0..) |selected, row| if (!selected and violated_row == null) {
+        violated_row = row;
+    };
+    matrix[violated_row.?] = 1.00001;
+    var result = try solvePrimaryConstraintGeneration(std.testing.allocator, &matrix, matrix.len, 1, null, 1000, clock.control(), .{ .context = &fake, .solve_restricted_fn = AddedThenTerminalSolver.solve });
+    defer result.deinit();
+    switch (result) {
+        .accepted => return error.UnexpectedAccepted,
+        .terminal => |terminal| {
+            try std.testing.expectEqual(TerminalReason.solver_time_limit, terminal.reason);
+            try std.testing.expectEqual(@as(usize, 1), terminal.diagnostics.round_count);
+            try std.testing.expectEqual(@as(usize, 1), terminal.diagnostics.rounds[0].added_rows);
+            try std.testing.expectEqual(violated_row.?, terminal.diagnostics.rounds[0].added_row_indices[0]);
+        },
+    }
