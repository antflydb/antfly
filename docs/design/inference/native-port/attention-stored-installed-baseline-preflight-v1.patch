+pub fn writeFailureReceipt(io: std.Io, path: []const u8, external: [32]u8, capture: [32]u8, build: [32]u8, error_name: []const u8, receipt: installed.Receipt) !void {
+    if (error_name.len == 0 or receipt.completed or !receipt.diagnostic_only or receipt.serving_authority or receipt.release_authority)
+        return error.InvalidContextTransaction;
+    // Use the same exclusive temporary-file, fsync, rename and parent-fsync
+    // implementation as writeReceipt; never replace an existing receipt.
+    try writeFailureEnvelopeAtomic(io, path, .{ .error_name = error_name, .external_manifest_sha256 = external, .capture_input_manifest_sha256 = capture, .source_build_sha256 = build, .installed = receipt });
+}
