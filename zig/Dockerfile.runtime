FROM --platform=$BUILDPLATFORM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime-libraries

ARG ZIG_VERSION=0.17.0
ARG WASMTIME_VERSION=v45.0.2
ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) wasmtime_arch="x86_64"; wasmtime_sha256="c32ade1d96bbc5e2a835bd9016cb305c370c1a183c6ccaea5bf1c0b72d229eda" ;; \
        arm64) wasmtime_arch="aarch64"; wasmtime_sha256="d0efd17b38850638e039dac3ffa91e22df0f2c00b9b71471df165e896a5125a8" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    archive="wasmtime-${WASMTIME_VERSION}-${wasmtime_arch}-linux-c-api.tar.xz" && \
    curl -fsSL "https://github.com/bytecodealliance/wasmtime/releases/download/${WASMTIME_VERSION}/${archive}" -o "/tmp/${archive}" && \
    echo "${wasmtime_sha256}  /tmp/${archive}" | sha256sum --check --strict && \
    mkdir -p /opt/wasmtime && \
    tar -xJf "/tmp/${archive}" -C /opt/wasmtime --strip-components=1 && \
    test -f /opt/wasmtime/lib/libwasmtime.so

# GKE supplies the CUDA driver, but EmbeddingGemma 2 also requires cuBLASLt.
# Pin the runtime redistributables from NVIDIA's CUDA 12.9.1 manifest:
# https://developer.download.nvidia.com/compute/cuda/redist/redistrib_12.9.1.json
# arm64 uses the server (SBSA) build. Keep headers and static libraries out of
# the runtime image, and retain NVIDIA's redistribution license.
RUN case "${TARGETARCH}" in \
        amd64) cublas_arch="x86_64"; cublas_sha256="546addc4a9d82b8f23aa9ba9274b6bc0429a63008a31c759884ac24880796057" ;; \
        arm64) cublas_arch="sbsa"; cublas_sha256="e99b074e6f66034e563508118804599d7579f73afc8424c55ad5fd8d12e085a5" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    package="libcublas-linux-${cublas_arch}-12.9.1.4-archive" && \
    curl -fsSL "https://developer.download.nvidia.com/compute/cuda/redist/libcublas/linux-${cublas_arch}/${package}.tar.xz" -o /tmp/cublas.tar.xz && \
    echo "${cublas_sha256}  /tmp/cublas.tar.xz" | sha256sum --check --strict && \
    mkdir -p /opt/cublas && \
    tar -xJf /tmp/cublas.tar.xz -C /opt/cublas --strip-components=1 \
        --wildcards "${package}/lib/libcublasLt.so*" "${package}/LICENSE*" && \
    test -f /opt/cublas/lib/libcublasLt.so.12 && \
    rm /tmp/cublas.tar.xz

# LightOn BF16 vision uses cuDNN graph attention. Bundle its CUDA 12 runtime
# and NVRTC dependencies alongside the existing CUDA 12.9 cuBLASLt ABI.
# Pins: NVIDIA redistrib_9.19.0.json and CUDA redistrib_12.9.1.json.
RUN case "${TARGETARCH}" in \
        amd64) vendor_arch="x86_64"; cudnn_sha256="9762704894a2c4c6e6f9cda831b1fd55b79e3038955fe551a880a6ce1fe140e2"; cudart_sha256="1f6ad42d4f530b24bfa35894ccf6b7209d2354f59101fd62ec4a6192a184ce99"; nvrtc_sha256="82913658363892dbc0f2638b070476234476e06e084fed60db861cb7e161a6af" ;; \
        arm64) vendor_arch="sbsa"; cudnn_sha256="d2d3d64c87bd4bc067e2c518e30814fbab00f3e8a8c84c33efe2e826290d00a4"; cudart_sha256="8b422a3b2cb8452cb678181b0bf9d7aa7342df168b5319c5488ae3b8514101fc"; nvrtc_sha256="fb2d50c791465f333fc2236d2419170cf7a7886f48dd9b967a10f8233c686029" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    package="cudnn-linux-${vendor_arch}-9.19.0.56_cuda12-archive" && \
    curl -fsSL "https://developer.download.nvidia.com/compute/cudnn/redist/cudnn/linux-${vendor_arch}/${package}.tar.xz" -o /tmp/cudnn.tar.xz && \
    echo "${cudnn_sha256}  /tmp/cudnn.tar.xz" | sha256sum --check --strict && \
    mkdir -p /opt/cudnn && \
    tar -xJf /tmp/cudnn.tar.xz -C /opt/cudnn --strip-components=1 \
        --wildcards "${package}/lib/*.so*" "${package}/LICENSE*" && \
    test -f /opt/cudnn/lib/libcudnn.so.9 && \
    rm /tmp/cudnn.tar.xz && \
    for component in "cuda_cudart:12.9.79:${cudart_sha256}" "cuda_nvrtc:12.9.86:${nvrtc_sha256}"; do \
        name="${component%%:*}"; rest="${component#*:}"; version="${rest%%:*}"; checksum="${rest#*:}"; \
        package="${name}-linux-${vendor_arch}-${version}-archive"; \
        curl -fsSL "https://developer.download.nvidia.com/compute/cuda/redist/${name}/linux-${vendor_arch}/${package}.tar.xz" -o /tmp/vendor.tar.xz && \
        echo "${checksum}  /tmp/vendor.tar.xz" | sha256sum --check --strict && \
        mkdir -p "/opt/${name}" && \
        tar -xJf /tmp/vendor.tar.xz -C "/opt/${name}" --strip-components=1 \
            --wildcards "${package}/lib/*.so*" "${package}/LICENSE*" && \
        rm /tmp/vendor.tar.xz || exit 1; \
    done

FROM --platform=$TARGETPLATFORM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

LABEL org.opencontainers.image.source=https://github.com/antflydb/antfly
LABEL org.opencontainers.image.description="AntflyDB Zig runtime image"
LABEL org.opencontainers.image.licenses=Elastic-2.0

ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget libstdc++6 && \
    if [ "${TARGETARCH}" = amd64 ]; then apt-get install -y --no-install-recommends libopenblas0-pthread; fi && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 antfly && \
    useradd --uid 10001 --gid antfly --create-home --home-dir /home/antfly --shell /usr/sbin/nologin antfly && \
    mkdir -p /antflydb && chown 10001:10001 /antflydb

WORKDIR /
COPY antfly /antfly
COPY share/antfly /usr/share/antfly
COPY --from=runtime-libraries /opt/wasmtime/lib/libwasmtime.so /usr/local/lib/libwasmtime.so
COPY --from=runtime-libraries /opt/cublas/lib/ /usr/local/lib/
COPY --from=runtime-libraries /opt/cublas/LICENSE* /usr/share/doc/antfly/cublas/
COPY --from=runtime-libraries /opt/cudnn/lib/ /usr/local/lib/
COPY --from=runtime-libraries /opt/cudnn/LICENSE* /usr/share/doc/antfly/cudnn/
COPY --from=runtime-libraries /opt/cuda_cudart/lib/ /usr/local/lib/
COPY --from=runtime-libraries /opt/cuda_cudart/LICENSE* /usr/share/doc/antfly/cudart/
COPY --from=runtime-libraries /opt/cuda_nvrtc/lib/ /usr/local/lib/
COPY --from=runtime-libraries /opt/cuda_nvrtc/LICENSE* /usr/share/doc/antfly/nvrtc/

ENV ANTFLY_WASMTIME_LIB=/usr/local/lib/libwasmtime.so
# GKE mounts the host CUDA driver here; keep Wasmtime's bundled library path.
# These directories can be absent on CPU-only nodes without affecting startup.
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/nvidia/lib:/usr/local/lib
ENV ANTFLY_EXTENSION_PACKAGE_STORE=/tmp/antflydb/extensions

# Exercise the target architecture's glibc loader during the image build.
# Wasmtime and cuBLASLt are loaded at runtime. Check cuBLASLt's dependencies
# and relocations without requiring an NVIDIA driver or GPU on the builder.
RUN ldd /antfly && \
    ldd /usr/local/lib/libwasmtime.so && \
    ldd -r /usr/local/lib/libcublasLt.so.12 > /tmp/cublaslt-ldd.txt 2>&1 && \
    cat /tmp/cublaslt-ldd.txt && \
    ! grep -E 'not found|undefined symbol' /tmp/cublaslt-ldd.txt && \
    rm /tmp/cublaslt-ldd.txt && \
    for library in libcudnn.so.9 libcudnn_graph.so.9 libnvrtc.so.12 libcudart.so.12; do \
        ldd -r "/usr/local/lib/${library}" > /tmp/vendor-ldd.txt 2>&1 && \
        cat /tmp/vendor-ldd.txt && \
        ! grep -E 'not found|undefined symbol' /tmp/vendor-ldd.txt || exit 1; \
    done && \
    rm /tmp/vendor-ldd.txt && \
    /antfly --version

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget -qO- http://localhost:4200/readyz || exit 1

USER 10001:10001

EXPOSE 8080 11433 4200

ENTRYPOINT ["/antfly"]
CMD ["standalone"]
