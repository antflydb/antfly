  "confirmed_costs": [
    {
      "finding": "Reader epoch publication repeats filesystem namespace validation and marker create/unlink for short logical read transactions.",
      "evidence": "Baseline stack samples show these calls during table/index reconstruction; first import used about 50 seconds of system CPU with ReleaseFast native code.",
      "proper_fix": "Share immutable protection for identical inode, binding, canonical path, checkpoint and scope during a held admission lease. Rotate anchors when checkpoints advance, release idle anchors on lease close/yield, and retain independent references for escaped readers. Unsafe aliases retain inode locks.",
      "prototype": "implemented, under qualification; no format or public ABI change"
    },
    {
      "finding": "SQL DDL recovery eagerly opens all available tables after recovery state is invalidated by replacement runtimes.",
      "evidence": "Owner.refresh only inherits clean recovery flags for its recognized maintenance snapshot; sql_ddl.recover calls tables.loadAvailable before examining per-table durable work. Samples show SQL waiting on the owner gate during this path.",
      "proper_fix": "Persist a recovery work catalog and generation atomically with the mutations that create/advance/finish SQL commit, FK, DDL retirement and activation work. Discover pending table identities without opening every index. Budget recovery per turn. Empty work is a checkpoint-bound durable fact, not a copied Boolean.",
      "required_tests": [
        "Crash at each job/catalog publication boundary.",
        "Foreign-process create/alter/drop and pending activation observed after reopen.",
        "Read-only opens do not skip required recovery.",
        "No clean flag is inherited across unrecognized schema generations."
      ]
    },
    {
      "finding": "Runtime invalidation is coupled to physical checkpoint movement.",
      "evidence": "runtimeMetadataUnchanged requires the previous checkpoint still be retained and checks primary roots before separately validating loaded index inputs.",
      "proper_fix": "Use durable logical generations for table identity, schema, primary data and index manifests; adopt allocator bookkeeping independently. Refresh only affected namespaces and immutable inputs. Capture heavy opens outside admission, then validate exact generation/inode/binding under admission before adoption.",
      "required_tests": [
        "Same page number reused for a different generation cannot validate an old runtime.",
        "Foreign writer changes and generation replacement are detected.",
        "Borrowed cursors and detached tasks retain their original immutable inputs.",
        "Failed speculative opens release leases and cannot publish partial runtime state."
      ]
    },
    {
      "finding": "Small bounded replay batches can multiply per-batch open/publication costs; causal contribution is not yet measured.",
      "proper_fix": "After fixed costs are removed, tune replay with byte, memory, elapsed-time and retirement-pressure bounds. Batch compatible publications without extending an old snapshot across unrelated work. Keep fair foreground admission and per-table progress.",
      "status": "hypothesis requiring matched experiment, not a confirmed regression attribution"
    }
  ],
  "storage_accounting": {
    "confirmed": "Native live_bytes sums logical key and value lengths; new record headers and hashes are excluded.",
    "measurement_caveat": "lite compact drains maintenance, forces text-index compaction and syncs indexes before vacuum. Its logical payload is not a read-only measurement of the imported state.",
    "next_steps": [
      "Compare read-only live accounting before and after maintenance on the same imported database.",
      "Attribute bytes and counts by documents, metadata, and index artifacts; use aggregate lengths and hashes, not private payloads.",
      "Compare all revisions at equivalent index catch-up/merge state."
    ],
    "unresolved": "The reported approximately 430 MB extra logical payload and 301 records are not yet attributed."
  },
