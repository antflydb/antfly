  "implementation_order": [
    {
      "phase": 1,
      "change": "Admission-scoped immutable epoch registration",
      "complexity_target": "Marker publication follows distinct protected checkpoints/scopes and escaping readers, rather than every short read. No idle anchors survive admission yield.",
      "acceptance": [
        "Original importer unchanged; paired native Debug baseline/candidate in both orders.",
        "Kernel/namespace safety regressions pass.",
        "Matched indexed churn verifies every acknowledged latest value, index catch-up, integrity and reopen."
      ]
    },
    {
      "phase": 2,
      "change": "Durable recovery agenda and namespace generation identities",
      "complexity_target": "Ordinary admission has no work proportional to all tables or all indexes. Recovery enumerates pending identities and opens only affected runtimes.",
      "compatibility": "If older writers cannot maintain the new durable generation/agenda contract, change the unreleased format/protocol and reject those writers. Do not silently trust counters that older code does not update.",
      "acceptance": [
        "Unrelated-table count scaling: adding idle tables must not induce a full-open scan per ordinary write.",
        "Crash/reopen and foreign DDL tests validate agenda completeness.",
        "All producers of activation, FK, retirement and transaction work publish the agenda atomically through shared storage contracts, not only SQL wrappers."
      ]
    },
    {
      "phase": 3,
      "change": "Speculative immutable input opens and precise runtime adoption",
      "complexity_target": "Heavy index initialization runs outside the owner gate; bounded adoption validates durable logical generations and inode identity. Unchanged immutable inputs retain their caches.",
      "acceptance": [
        "Cursor, schema mutation, shutdown and detached worker lifecycle draining remains correct.",
        "Foreign publication during speculative open discards stale work safely.",
        "No borrowed mutable allocator state is shared with retired readers."
      ]
    },
    {
      "phase": 4,
      "change": "Adaptive replay/service scheduling after fixed costs are removed",
      "complexity_target": "Memory, elapsed time and retirement pressure bound each turn while checkpoint/open work is amortized; foreground and reclamation retain progress.",
      "acceptance": [
        "Measure foreground p50/p95/p99 and success rates as well as background throughput.",
        "File/retirement backlog must plateau while writers remain active, with an explicit retained-snapshot case and bounded drain afterward.",
        "Post-commit visibility failures remain distinct from pre-commit retryable refusal."
      ]
    }
  ],
