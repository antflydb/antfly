{
  "kind": "implementation_checkpoint",
  "qualification": false,
  "base_commit": "c9ed82860591fa6d061b7fd4f8907b97709dd80a",
  "components": [
    {
      "component": "SQL dependency validity",
      "implementation": "Revision-9 transactional semantic revisions for schema-bearing namespaces; schema-directory, namespace-incarnation and FK-connected table witnesses. Table discovery extends only over newly staged entries and clears on rollback/reset. Missing revisions retain conservative file-wide validity. COMMIT still revalidates all predicates and constraints."
    },
    {
      "component": "Writer allocator ownership",
      "implementation": "A path-owned cache exclusively loans checked ledger/digest state to native transactions, page allocation and admitted inspection. Clean state returns after publication; dirty or uncertain state never becomes authority. Existing inode/header/certificate/rebase checks remain. Detached proof capture and publication serialize mutable wrapper bookkeeping under the Store mutex. Generation publication rejects active loans and immediately closes any cached retired descriptor, preserving cumulative work counters."
    },
    {
      "component": "Resumable full-text replay",
      "implementation": "Durable index-generation/configuration/namespace-bound continuations split oversized journal records by primary document family. Row, delete, overwrite and asset effects remain together. Index durability precedes continuation publication. Scalar applied progress and completion seals advance only after the record completes. No-op scan progress is retained without certifying corpus completeness."
    },
    {
      "component": "One bounded text projection",
      "implementation": "Planning retains one source-byte-bounded window with ordinals, owned schema/analyzer dependencies and chunk-local field observations. Producer admission precedes segment allocation; preparation consumes the retained projection. Configuration changes replan only unpublished input. Projection memory is resource-accounted. Planning and preparation have separate numeric timing counters so cost cannot disappear by moving between stages."
    },
    {
      "component": "Detached source and immutable text runtime separation",
      "implementation": "Eligible text runtimes, including relational text tables, retain immutable index inputs under inode/index/catalog/namespace and table/policy-control witnesses, with a fresh primary epoch and reset replay/source/visibility observations each turn. Durable worker positions and table catalogs reload at rebinding. Residency is bounded to root plus one namespace and ends when work settles. Cache, active turns and immutable merge jobs own independent strong references; starting a merge does not evict a reusable runtime, and retired owners remain alive until their jobs are joined. Unsupported index/provider state reopens conservatively. Named-table maintenance discovers and executes on its detached runtime instead of also opening a serving table."
    },
    {
      "component": "Preparation feedback under contention",
      "implementation": "Both replay controllers exclude measured admission/publication overhead when sizing preparation windows, while call deadlines and yield decisions continue to include that time."
    }
  ],
