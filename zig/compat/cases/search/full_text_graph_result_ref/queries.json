[
  {
    "name": "full_text_to_graph",
    "request": {
      "index_name": "ft_v1",
      "full_text": {
        "match": {
          "field": "body",
          "text": "machine learning"
        }
      },
      "graph_queries": {
        "citations": {
          "index": "gr_v1",
          "traverse": {
            "start": {
              "result_ref": "$full_text_results",
              "limit": 5
            },
            "edge_types": ["cites"],
            "max_depth": 1,
            "limit": 5
          }
        }
      },
      "limit": 10,
      "offset": 0,
      "include_stored": true
    }
  }
]
