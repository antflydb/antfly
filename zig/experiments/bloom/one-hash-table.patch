+// Experimental single-input-hash derivation, paired with ABLOOM3 only.
+fn experimentalBloomHashPair(h1: u64) [2]u64 {
+    var h2 = h1;
+    h2 ^= h2 >> 30;
+    h2 *%= 0xbf58476d1ce4e5b9;
+    h2 ^= h2 >> 27;
+    h2 *%= 0x94d049bb133111eb;
+    h2 ^= h2 >> 31;
+    return .{ h1, h2 };
+}
