    "view_sql": "CREATE VIEW support_view AS SELECT d._id,r.title AS title_text,r.status,r.metadata->>'plan' AS plan,r.metadata->>'region' AS region,(r.metrics->>'score')::numeric AS score,(r.flags->>'published')::boolean AS published,r.tags AS tag_list,r.metadata,r.note FROM docs d CROSS JOIN LATERAL jsonb_to_record(d._doc) AS r(title TEXT,status TEXT,metadata JSONB,metrics JSONB,flags JSONB,tags TEXT[],note TEXT)"
  },
