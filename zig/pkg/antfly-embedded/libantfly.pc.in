prefix=${pcfiledir}/../..
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libantfly
Description: Apache Antfly embedded databases and inference C API
Version: @VERSION@
Libs: -L${libdir} -lantfly -Wl,-rpath,${libdir}
Cflags: -I${includedir}
