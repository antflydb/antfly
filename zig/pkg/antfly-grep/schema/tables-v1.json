{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antfly grep table configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "endpoint",
    "tables"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 268435456
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "document_field": {
            "type": "string",
            "default": "grep"
          },
          "candidate_index": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "field"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "version_field": {
                "type": "string",
                "minLength": 1,
                "default": "grep_trigrams_version"
              }
            },
            "description": "Complete raw-content byte trigrams encoded as lowercase hex keyword terms; atomic with the source revision. Opt-in acceleration only."
          },
          "status": {
            "type": "string",
            "description": "Optional current source state supplied by Cloud discovery."
          },
          "access_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Source-specific access consistency precondition supplied by Cloud discovery."
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "description": "Optional physical table binding for a logical source."
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_filter": {
            "type": [
              "object",
              "null"
            ]
          },
          "valid_until": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "path",
              "revision",
              "indexed_at",
              "permissions",
              "metadata"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "indexed_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "permissions": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "metadata": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            }
          },
          "streams": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/SearchStream"
            }
          },
          "search_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "artifacts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/ArtifactBinding"
            }
          }
        },
        "dependentRequired": {
          "streams": [
            "fields"
          ]
        }
      }
    },
    "max_page_memory": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 1073741824
    },
    "prefetch": {
      "type": "boolean",
      "default": true,
      "description": "Overlap one retained-snapshot page with local processing. At most two decoded pages are live; quiet and finite per-file match limits use sequential retrieval."
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value_verification": {
          "type": "object",
          "additionalProperties": false,
          "description": "Ordinary query execution policy for logical value predicates. Budgets apply per shard request; exhausted budgets are explicit failures.",
          "properties": {
            "allow_scan": {
              "type": "boolean",
              "default": true
            },
            "max_documents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807,
              "default": 100000
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807,
              "default": 67108864
            },
            "max_regex_work": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807,
              "default": 100000000
            }
          }
        }
      }
    }
  },
  "$defs": {
    "SearchStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true,
          "description": "Legacy full-text binding; incompatible with retrieval. Use search_version=2 and retrieval for new configurations."
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "location_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "default": {
          "type": "boolean",
          "x-go-type-skip-optional-pointer": true,
          "description": "Legacy default for exact matching; version 2 uses defaults on each retrieval mode."
        },
        "generated": {
          "type": "boolean",
          "x-go-type-skip-optional-pointer": true
        },
        "boundary": {
          "enum": [
            "record",
            "unit"
          ],
          "x-go-type-skip-optional-pointer": true,
          "type": "string"
        },
        "resource_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalBindings",
          "x-go-type-skip-optional-pointer": false
        }
      }
    },
    "RetrievalBindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact": {
          "$ref": "#/$defs/ExactRetrieval",
          "x-go-type-skip-optional-pointer": false
        },
        "full_text": {
          "$ref": "#/$defs/FullTextRetrieval",
          "x-go-type-skip-optional-pointer": false
        },
        "semantic": {
          "$ref": "#/$defs/SemanticRetrieval",
          "x-go-type-skip-optional-pointer": false
        }
      }
    },
    "ExactRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "boolean"
        }
      }
    },
    "FullTextRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "default": {
          "type": "boolean"
        }
      },
      "required": [
        "index"
      ]
    },
    "SemanticRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "member_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$",
            "x-go-type-skip-optional-pointer": true
          },
          "maxItems": 64,
          "x-go-type-skip-optional-pointer": true
        },
        "vector_space": {
          "$ref": "#/$defs/VectorSpace"
        },
        "query_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "vector"
            ],
            "x-go-type-skip-optional-pointer": true
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "x-go-type-skip-optional-pointer": true
        },
        "default": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "member_field": {
          "type": "string",
          "description": "Projection returned from semantic members. Chunk-backed embeddings use text even when their ancestor representation is scalar ($). Managed textual streams must declare this field."
        }
      },
      "required": [
        "index",
        "vector_space",
        "query_inputs"
      ]
    },
    "VectorSpace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "metric": {
          "type": "string",
          "enum": [
            "cosine",
            "inner_product",
            "l2_squared"
          ],
          "x-go-type-skip-optional-pointer": true
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "query_preprocessing": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "document_preprocessing": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "query_modality": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "audio",
            "multimodal"
          ],
          "x-go-type-skip-optional-pointer": true
        },
        "document_modality": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "audio",
            "multimodal"
          ],
          "x-go-type-skip-optional-pointer": true
        }
      },
      "required": [
        "id",
        "dimension",
        "metric",
        "model",
        "revision",
        "query_preprocessing",
        "document_preprocessing",
        "query_modality",
        "document_modality"
      ]
    },
    "ArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "schema_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "location_field": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "x-go-type-skip-optional-pointer": true
        },
        "generated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "artifact",
        "content_type"
      ]
    }
  }
}
