{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable source catalog v2",
  "type": "object",
  "required": [
    "version",
    "endpoint",
    "sources",
    "principals"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "endpoint": {
      "type": "string",
      "format": "uri-reference",
      "description": "Ordinary Antfly API base. File catalogs require an absolute HTTPS/loopback URL. Cloud obtains its base from the authenticated instance context."
    },
    "principals": {
      "type": "array",
      "maxItems": 262144,
      "items": {
        "type": "string"
      },
      "description": "Additional client-side reader filtering, never server authorization."
    },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "table",
          "status",
          "filter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "document_field": {
            "type": "string",
            "default": "grep"
          },
          "filter": {
            "type": "object",
            "description": "Selection constraint applied through the normal query filter; grants no authority."
          },
          "status": {
            "enum": [
              "pending",
              "syncing",
              "searchable",
              "stale"
            ]
          },
          "valid_until": {
            "type": "integer",
            "description": "Optional Unix-second readiness/permission lease checked before requests."
          },
          "access_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Optional server-specific access-view precondition, never a capability."
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "path",
              "revision",
              "indexed_at",
              "permissions",
              "metadata"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "indexed_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "permissions": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              },
              "metadata": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000\\r\\n]+$"
              }
            }
          },
          "streams": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "field",
                "default"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "index": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "location_field": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000\\r\\n]+$"
                },
                "default": {
                  "type": "boolean"
                },
                "generated": {
                  "type": "boolean"
                },
                "boundary": {
                  "enum": [
                    "record",
                    "unit"
                  ],
                  "type": "string"
                }
              },
              "dependentRequired": {
                "artifact": [
                  "index"
                ]
              }
            }
          },
          "document_version": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "publication": {
            "enum": [
              "text",
              "media",
              "native"
            ]
          },
          "published_revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        }
      }
    }
  }
}
