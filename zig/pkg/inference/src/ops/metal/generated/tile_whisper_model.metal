        const float pr = exp(s - m_new);
        l = l * corr + pr;
        for (uint t = 0u; t < 2u; ++t) o[t] = o[t] * corr + pr * v[j * p.ld_v + h * 64u + lane + 32u * t];
        m = m_new;
    }
    const float inv = l > 0.0f ? 1.0f / l : 0.0f;
    for (uint t = 0u; t < 2u; ++t) out[i * p.ld_o + h * 64u + lane + 32u * t] = o[t] * inv;
