    for (uint t = 0u; t < 2u; ++t) { qv[t] = q[i * p.ld_q + h * 64u + lane + 32u * t] * p.scale; o[t] = 0.0f; }
    const uint limit = (p.causal != 0u && p.q_offset + i + 1u < p.tk) ? p.q_offset + i + 1u : p.tk;
    float m = (-INFINITY); float l = 0.0f;
    for (uint j = 0u; j < limit; ++j) {
        float part = 0.0f;
        for (uint t = 0u; t < 2u; ++t) part += qv[t] * k[j * p.ld_k + h * 64u + lane + 32u * t];
        const float s = simd_sum(part);
        const float m_new = max(m, s);
