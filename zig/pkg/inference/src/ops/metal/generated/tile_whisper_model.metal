        threadgroup_barrier(mem_flags::mem_threadgroup);
        float total = 0.0f;
        for (uint i = 0u; i < sg_count; ++i) total += red[i];
        sum = total;
        threadgroup_barrier(mem_flags::mem_threadgroup);
