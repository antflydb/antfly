        threadgroup_barrier(mem_flags::mem_threadgroup);
        float total = 0.0f;
        for (uint i = 0u; i < sg_count; ++i) total += red[i];
        sq = total;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    const float inv = rsqrt(sq / (float)p.dim + 1e-5f);
    for (uint c = tid; c < p.dim; c += 128u) out[base + c] = (x[base + c] - mean) * inv * gamma[c] + beta[c];
}

