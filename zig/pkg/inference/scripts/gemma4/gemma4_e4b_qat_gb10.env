#
# Opt-in Gemma 4 E4B QAT Q4_0 profile for NVIDIA GB10 (SM 12.1), F16 K/V.
# Source before starting a dedicated server or qualification harness.
# CUDA graph capacity is 2048 total tokens; use bounded requests that fit it.
# BF16 prefill weight mirrors increase resident memory; keep the original GGUF.
# The Flash profile retains its original SM89 name; E4B also supports SM 12.1.
# Performance evidence: qualification/e4b-qat-gb10-decode-20261029.json.
# ASR accuracy must be qualified separately; this is not a universal GPU default.
export ANTFLY_INFERENCE_CUDA_ASYNC_I32_DOWNLOAD_STAGING=1
export ANTFLY_INFERENCE_CUDA_CAPTURE_DEVICE_SCALARS=1
export ANTFLY_INFERENCE_CUDA_CAPTURE_FORCE_KV_CAPACITY=2048
export ANTFLY_INFERENCE_CUDA_CAPTURE_PERSISTENT_REPLAY=1
export ANTFLY_INFERENCE_CUDA_CAPTURE_UPDATE_EXEC=1
export ANTFLY_INFERENCE_CUDA_DECODE_GRAPH_REPLAY=required
export ANTFLY_INFERENCE_CUDA_E4B_F16_WARP_SPLIT=1
export ANTFLY_INFERENCE_CUDA_GENERATED_ATTENTION_SCORE_PREWORK=0
export ANTFLY_INFERENCE_CUDA_GENERATED_ATTENTION_SCORE_PREWORK_CONSUMER=serial
export ANTFLY_INFERENCE_CUDA_GQA_PREFILL_PROFILE=required-flash-f16-sm89
export ANTFLY_INFERENCE_CUDA_GREEDY_PENDING_TOKEN_READBACK=1
export ANTFLY_INFERENCE_CUDA_PLE_MODEL_PROJ_BF16=1
export ANTFLY_INFERENCE_CUDA_PREFILL_FIRST_TOKEN=1
export ANTFLY_INFERENCE_CUDA_PREFILL_FIRST_TOKEN_COALESCE_TOKENS=0
export ANTFLY_INFERENCE_CUDA_Q4_0_ACTIVATION_SLICE_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_GATED_DOWN_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_GATE_UP_ACTIVATION_PRECOMPUTE=1
export ANTFLY_INFERENCE_CUDA_Q4_0_LINEAR_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_LINEAR_Q8_1_TILE4_W10_E4B_DOWN=1
export ANTFLY_INFERENCE_CUDA_Q4_0_LINEAR_Q8_1_TILE4_W8=1
export ANTFLY_INFERENCE_CUDA_Q4_0_LINEAR_Q8_1_TILE4_W8_MIN_IN_DIM=2048
export ANTFLY_INFERENCE_CUDA_Q4_0_LM_HEAD_Q8_1_ARGMAX=1
export ANTFLY_INFERENCE_CUDA_Q4_0_PAIR_ACTIVATION_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_PAIR_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_PAIR_Q8_1_TILE4_W8=1
export ANTFLY_INFERENCE_CUDA_Q4_0_QKV_Q8_1_DP4A=1
export ANTFLY_INFERENCE_CUDA_Q4_0_QKV_Q8_1_TILE8=1
export ANTFLY_INFERENCE_CUDA_Q4_0_WEIGHTS_BF16_PREFILL=1
export ANTFLY_INFERENCE_CUDA_Q6_K_LM_HEAD_Q8_1=1
export ANTFLY_INFERENCE_CUDA_Q6_K_LM_HEAD_Q8_1_TILE8_EXACT_THREADS=1
export ANTFLY_INFERENCE_CUDA_RMS_NORM_BF16_MIRROR=1
export ANTFLY_INFERENCE_CUDA_TEMP_ARENA_AUTOPLAN=1
export ANTFLY_INFERENCE_CUDA_TURBOQUANT_SPLIT_ATTENTION=1
export ANTFLY_INFERENCE_CUDA_TURBOQUANT_SPLIT_ATTENTION_CHUNK=64
