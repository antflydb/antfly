#
# Conservative functional baseline for Gemma 4 E4B on NVIDIA A100 (SM80).
# Use with_gemma4_a100_cuda.sh to discard inherited experimental CUDA tuning.
# This has not been runtime-qualified or benchmarked on an A100.
# Keep generic CUDA fallback routes; no GB10/SM89-only required profiles.
export ANTFLY_SERVER_DECODE_GRAPH_REPLAY=off
export ANTFLY_INFERENCE_DISABLE_CONTINUOUS_BATCHING=1
export ANTFLY_INFERENCE_CUDA_DECODE_GRAPH_REPLAY=off
export ANTFLY_INFERENCE_CUDA_CAPTURE_FORCE_KV_CAPACITY=0
export ANTFLY_INFERENCE_CUDA_CAPTURE_PERSISTENT_REPLAY=0
export ANTFLY_INFERENCE_CUDA_CAPTURE_UPDATE_EXEC=0
export ANTFLY_INFERENCE_CUDA_GQA_PREFILL_PROFILE=off
export ANTFLY_INFERENCE_CUDA_GQA_DECODE_PROFILE=off
export ANTFLY_INFERENCE_CUDA_E4B_HEAD_PREFETCH_L2=0
export ANTFLY_INFERENCE_CUDA_E4B_PAIR_PREFETCH_L2=0
export ANTFLY_INFERENCE_CUDA_E4B_DOWN_PREFETCH_L2=0
export ANTFLY_INFERENCE_CUDA_RMS_Q8_1_MIRROR=0
export ANTFLY_INFERENCE_CUDA_CUBLASLT_BF16_TUNING_PROFILE=off
export ANTFLY_INFERENCE_CUDA_ALLOW_UNPROMOTED_GENERATED_KERNELS=0
export ANTFLY_INFERENCE_CUDA_Q4_0_WEIGHTS_BF16_PREFILL=0
export ANTFLY_INFERENCE_CUDA_RMS_NORM_BF16_MIRROR=0
export ANTFLY_INFERENCE_CUDA_PLE_MODEL_PROJ_BF16=0
