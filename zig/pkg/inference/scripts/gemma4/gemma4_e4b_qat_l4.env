#
# Opt-in Gemma 4 E4B QAT Q4_0 profile for NVIDIA L4 (SM 8.9), F16 K/V.
# Source before starting a dedicated server in an environment without other tuning profiles.
# Qualified greedy HTTP workloads use up to 4096 total tokens and 512 output tokens.
# The campaign uses a 4096 MiB scratch admission ceiling; actual memory is sampled.
# Evidence: qualification/e4b-qat-l4-http-20261115.md.
# Combined process footprint and VRAM are reported separately.
export ANTFLY_INFERENCE_CUDA_RMS_Q8_1_MIRROR=1
export ANTFLY_INFERENCE_CUDA_GENERATED_Q6_K_Q8_1_LM_HEAD_ARGMAX=1
