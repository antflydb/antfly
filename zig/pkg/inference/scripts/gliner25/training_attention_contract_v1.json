  "scope": "gliner25_projected_training_attention/v1",
  "semantics": {
    "control_layout": "physical i32: seed low/high, micro_batch low/high, replica low/high (bit limbs), then mask[B,S] 0/1, then 2*S-1 source bucket indices for -(S-1)..S-1",
    "counter": "splitmix64_site_element_v1; wrapping u64 stream=mix(seed)^mix(micro)^mix(replica+0x7265706c696361)^mix(stream_id); drop if high32(mix(stream^mix(index))) < floor(f64(f32(p))*2^32)",
    "counter_mix": "mix(v): v+=0x9e3779b97f4a7c15; v=(v^(v>>30))*0xbf58476d1ce4e5b9; v=(v^(v>>27))*0x94d049bb133111eb; return v^(v>>31), all wrapping u64",
    "dropout": "Explicit native counter masks replace nn.Dropout only; no claim to reproduce Torch RNG. Probabilities and inversion arithmetic use f32.",
    "dropout_inversion": "f32(1/f32(1-f32(p)))",
    "fully_masked_query": "uniform before dropout, zero score-path VJP, potentially nonzero V VJP including masked key rows",
    "gradient_inputs": [
      "Q[B*S,H]",
      "K[B*S,H]",
      "V[B*S,H]",
      "Qr[R,H]",
      "Kr[R,H]"
    ],
    "gradient_layout": "[dQ;dK;dV;dQr;dKr] rows 3*B*S+2*R",
    "mask": "query AND key, masked_fill with finite -maxf32 before softmax",
    "probability_index": "((b*num_heads+h)*S+q)*S+k; logical layer stream=(layer<<32)|3; relative-dropout stream=(layer<<32)|2",
    "projection_boundary": "Capture actual shared Q/K/V projection returns, then substitute those same values as five independent autograd leaves. Original and leaf replay context and probabilities must be byte-identical.",
    "qkv_layout": "[Q;K;V] in source B,S,H order",
    "relative_index": "both Qr and Kr use bucket(q-k) for equal-length self-attention after source p2c transpose",
    "relative_layout": "[Qr;Kr], R512 full projected shared table; table VJPs sum source batch repetition",
    "relative_order": "shared full-table LayerNorm, then per-layer relative dropout, then shared Q/K projections, then score gathers",
    "scale": "sqrt(3*head_dim); Q @ (K^T / scale), c2p and p2c each divided after its dot/gather, then summed in source order",
    "scope_limit": "Projected attention primitive only; this does not independently qualify raw relative embedding/projection weight gradients, full tiled encoder or training jobs, unequal query/key lengths, inference masking, or release readiness",
    "source_methods": "Actual pinned get_attention_mask/get_rel_embedding/get_rel_pos and DisentangledSelfAttention.forward/disentangled_attention_bias execute; attention math is not rewritten.",
    "source_rng": "torch.manual_seed(251019) generates only the tiny source encoder initialization; it is distinct from the explicit dropout counter"
  },
