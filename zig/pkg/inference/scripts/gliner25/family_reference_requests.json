{
  "format_version": 1,
  "requests": [
    {
      "id": "english_full_task",
      "kind": "extract",
      "text": "Maya Chen joined Acme Robotics in Seattle as research director.",
      "schema": {
        "entities": {
          "person": "A named individual",
          "organization": "A company or institution",
          "location": "A city or place"
        },
        "classifications": [
          {
            "task": "employment_status",
            "labels": ["joined", "left", "unchanged"]
          }
        ],
        "relations": ["works_for"],
        "structures": {
          "employment": {
            "fields": [
              {"name": "person", "dtype": "str"},
              {"name": "organization", "dtype": "str"},
              {"name": "title", "dtype": "str"}
            ]
          }
        }
      },
      "expect": {
        "contains_text": ["Maya Chen", "Acme Robotics", "Seattle"]
      }
    },
    {
      "id": "spanish_entities",
      "kind": "extract",
      "text": "María González trabaja para Banco Norte en Madrid.",
      "schema": {
        "entities": {
          "persona": "Nombre de una persona",
          "organización": "Empresa o institución",
          "lugar": "Ciudad o ubicación"
        }
      },
      "expect": {
        "contains_text": ["María González", "Banco Norte", "Madrid"]
      }
    },
    {
      "id": "japanese_entities",
      "kind": "extract",
      "text": "田中 は 東京 の ソニー で 働いています。",
      "schema": {
        "entities": {
          "人物": "人の名前",
          "組織": "会社または組織",
          "場所": "都市または場所"
        }
      },
      "expect": {
        "contains_text": ["田中", "東京", "ソニー"]
      }
    },
    {
      "id": "arabic_entities",
      "kind": "extract",
      "text": "تعمل ليلى منصور في شركة النور بمدينة دبي.",
      "schema": {
        "entities": {
          "شخص": "اسم شخص",
          "منظمة": "شركة أو مؤسسة",
          "مكان": "مدينة أو موقع"
        }
      },
      "expect": {
        "contains_text": ["ليلى منصور", "شركة النور", "دبي"]
      }
    },
    {
      "id": "english_intent",
      "kind": "classification",
      "text": "Please refund the duplicate card charge.",
      "schema": {
        "tasks": {
          "intent": {
            "labels": ["refund", "technical_support", "sales"],
            "min_labels": 1,
            "max_labels": 1
          }
        }
      },
      "expect": {"selected": {"intent": ["refund"]}}
    },
    {
      "id": "spanish_intent",
      "kind": "classification",
      "text": "Quiero cancelar mi reserva para mañana.",
      "schema": {
        "tasks": {
          "intención": {
            "labels": ["reservar", "cambiar", "cancelar", "consultar"],
            "min_labels": 1,
            "max_labels": 1
          }
        }
      },
      "expect": {"selected": {"intención": ["cancelar"]}}
    },
    {
      "id": "japanese_intent",
      "kind": "classification",
      "text": "注文をキャンセルしてください。",
      "schema": {
        "tasks": {
          "依頼": {
            "labels": ["注文", "変更", "キャンセル", "状況確認"],
            "min_labels": 1,
            "max_labels": 1
          }
        }
      },
      "expect": {"selected": {"依頼": ["キャンセル"]}}
    },
    {
      "id": "arabic_intent",
      "kind": "classification",
      "text": "أريد تغيير موعد رحلتي إلى يوم الجمعة.",
      "schema": {
        "tasks": {
          "الطلب": {
            "labels": ["حجز", "تغيير", "إلغاء", "استعلام"],
            "min_labels": 1,
            "max_labels": 1
          }
        }
      },
      "expect": {"selected": {"الطلب": ["تغيير"]}}
    },
    {
      "id": "described_labels",
      "kind": "classification",
      "text": "The new card arrived, but I never received its PIN and cannot use it.",
      "schema": {
        "tasks": {
          "intent": {
            "labels": {
              "card_pin_change": "The customer needs a new PIN or did not receive it",
              "card_lost": "The physical card is missing",
              "balance_inquiry": "The customer asks for an account balance"
            },
            "min_labels": 1,
            "max_labels": 1
          }
        }
      },
      "expect": {"selected": {"intent": ["card_pin_change"]}}
    },
    {
      "id": "instruction_prompt",
      "kind": "classification",
      "text": "The treaty was signed in 1992 and entered into force in 1993.",
      "schema": {
        "tasks": {
          "answer": {
            "labels": ["yes", "no"],
            "min_labels": 1,
            "max_labels": 1,
            "instruction": "Did the treaty enter into force in 1992?"
          }
        }
      },
      "expect": {"selected": {"answer": ["no"]}}
    },
    {
      "id": "multi_label_aspects",
      "kind": "classification",
      "text": "The battery dies before lunch, but the keyboard and screen are excellent.",
      "schema": {
        "tasks": {
          "aspects": {
            "labels": ["battery", "keyboard", "screen", "camera", "price", "support"],
            "min_labels": 0,
            "max_labels": 6,
            "threshold": 0.4
          }
        }
      },
      "expect": {"selected_contains": {"aspects": ["battery", "keyboard", "screen"]}}
    }
  ]
}
