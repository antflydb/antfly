{
  "version": 1,
  "scope": "native F32 CPU image embedding through the production HTTP server on this Linux aarch64 GB10",
  "natural_image_holdout": {
    "dataset": "jxie/flickr8k",
    "revision": "56f58c967835f7c508d684f36bd7897cca9d7634",
    "split": "test",
    "images": 128,
    "captions_per_image": 5,
    "selection": "smallest SHA256 of image bytes, no outcome-based selection"
  },
  "numerical": {
    "lossless_max_abs": 0.0001,
    "lossless_min_cosine": 0.99999,
    "jpeg_max_abs": 0.001,
    "jpeg_min_cosine": 0.9999,
    "norm_error": 0.0001,
    "dimensions": [
      128,
      256,
      512,
      768
    ]
  },
  "retrieval": {
    "search": "exact F64 cosine; fixed independently embedded caption vectors; CPU versus upstream F32 image vectors",
    "max_recall1_loss": 0.01,
    "max_recall5_loss": 0.01,
    "max_ndcg10_loss": 0.005,
    "directions": [
      "text_to_image",
      "image_to_text"
    ],
    "recall_definition": "fraction of queries with at least one relevant item in the first K results",
    "additional_baselines": [
      "fixed CUDA caption queries with upstream F32 image index",
      "fixed CUDA caption queries with canonical CUDA BF16 image index"
    ]
  },
  "serving": {
    "profile_clients": [
      1,
      2,
      4
    ],
    "profile_seconds": 60,
    "soak_clients": 2,
    "soak_seconds": 600,
    "p95_seconds_per_client": 8,
    "cold_first_image_max_seconds": 90,
    "max_worker_rss_bytes": 10737418240,
    "max_profile_rss_growth_bytes": 268435456,
    "expected_errors": 0
  },
  "source_image_envelope": {
    "max_width": 2048,
    "max_height": 2048,
    "max_encoded_bytes": 4194304,
    "steady_state_images_per_request": 1
  },
  "recovery": [
    "deadline during image execution",
    "TCP reset",
    "legal half-close",
    "correct pinned retry",
    "8-client overload against 4 request slots",
    "malformed images",
    "per-item errors",
    "batch order",
    "dimension restoration"
  ],
  "not_qualified": [
    "x86",
    "hard container memory limits or CPU quotas",
    "FP16/BF16 CPU variants",
    "audio/video",
    "animated-image temporal embedding",
    "customer-specific latency/relevance SLO",
    "low-latency text queries sharing an image-loaded service"
  ]
}
