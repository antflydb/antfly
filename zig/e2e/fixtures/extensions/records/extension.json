{
  "manifest_api_version": "extensions/v1",
  "name": "records",
  "version": "0.0.1",
  "kind": "extension",
  "description": "Reference Records extension package with MCP tool handlers compiled to WASM.",
  "digest": "sha256:records-0.0.1-reference",
  "trusted": false,
  "relocatable": true,
  "capabilities_requested": [
    {
      "name": "db:read",
      "scope": "records"
    },
    {
      "name": "db:write",
      "scope": "records"
    },
    {
      "name": "ai:embed",
      "scope": "records"
    },
    {
      "name": "mcp:tool",
      "scope": "records"
    }
  ],
  "artifacts": [
    {
      "kind": "wasm",
      "path": "target/wasm32-wasip2/release/records_extension.wasm",
      "digest": "sha256:build-records-0.0.1-wasm"
    },
    {
      "kind": "asset",
      "path": "wit/antfly-extension.wit",
      "digest": "sha256:source-records-0.0.1-wit"
    }
  ],
  "install": {
    "scopes_supported": [
      "cluster",
      "table"
    ],
    "shapes": [
      {
        "name": "record_record",
        "kind": "document",
        "version": "1",
        "schema_json": "{\"default_type\":\"record\",\"enforce_types\":true,\"document_schemas\":{\"record\":{\"schema\":{\"type\":\"object\",\"required\":[\"content\",\"record_type\"],\"properties\":{\"id\":{\"type\":\"keyword\"},\"content\":{\"type\":\"text\"},\"record_type\":{\"type\":\"keyword\"},\"project\":{\"type\":\"keyword\"},\"tags\":{\"type\":\"keyword\"},\"visibility\":{\"type\":\"keyword\"},\"created_by\":{\"type\":\"keyword\"},\"source_backend\":{\"type\":\"keyword\"},\"source_id\":{\"type\":\"keyword\"},\"session_id\":{\"type\":\"keyword\"},\"agent_id\":{\"type\":\"keyword\"},\"device_id\":{\"type\":\"keyword\"},\"created_at\":{\"type\":\"keyword\"},\"updated_at\":{\"type\":\"keyword\"}}}}}}"
      },
      {
        "name": "record_embedding",
        "kind": "generated_artifact",
        "version": "1",
        "schema_json": "{\"type\":\"object\",\"properties\":{\"vector\":{\"type\":\"array\",\"items\":{\"type\":\"number\"}},\"model\":{\"type\":\"string\"}}}"
      },
      {
        "name": "store_record_request",
        "kind": "tool_schema",
        "version": "1",
        "schema_json": "{\"type\":\"object\",\"required\":[\"content\"],\"properties\":{\"content\":{\"type\":\"string\"},\"record_type\":{\"type\":\"string\",\"enum\":[\"episodic\",\"semantic\",\"procedural\"]},\"project\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"visibility\":{\"type\":\"string\",\"enum\":[\"team\",\"private\"]},\"source_backend\":{\"type\":\"string\"},\"source_id\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"agent_id\":{\"type\":\"string\"},\"device_id\":{\"type\":\"string\"},\"ephemeral\":{\"type\":\"boolean\"}}}"
      },
      {
        "name": "search_records_request",
        "kind": "tool_schema",
        "version": "1",
        "schema_json": "{\"type\":\"object\",\"required\":[\"query\"],\"properties\":{\"query\":{\"type\":\"string\"},\"project\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"record_type\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"expand_graph\":{\"type\":\"boolean\"},\"scope\":{\"type\":\"string\",\"enum\":[\"session\",\"agent\",\"device\"]},\"session_id\":{\"type\":\"string\"},\"agent_id\":{\"type\":\"string\"},\"device_id\":{\"type\":\"string\"},\"ephemeral\":{\"type\":\"boolean\"}}}"
      },
      {
        "name": "list_records_request",
        "kind": "tool_schema",
        "version": "1",
        "schema_json": "{\"type\":\"object\",\"properties\":{\"project\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"record_type\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"},\"session_id\":{\"type\":\"string\"},\"agent_id\":{\"type\":\"string\"},\"device_id\":{\"type\":\"string\"},\"ephemeral\":{\"type\":\"boolean\"}}}"
      }
    ],
    "objects": [
      {
        "kind": "generated_artifact",
        "name": "record_embedding",
        "shape": "record_embedding",
        "config_json": "{\"kind\":\"embedding\",\"source_shape\":\"record_record\",\"source_field\":\"content\",\"model\":\"antfly/default-embedding\"}"
      },
      {
        "kind": "index",
        "name": "record_text",
        "config_json": "{\"type\":\"full_text\",\"fields\":[\"content\",\"project\",\"tags\"]}"
      },
      {
        "kind": "skill",
        "name": "record",
        "config_json": "{\"displayName\":\"Records Record\",\"description\":\"Store, list, and search durable Records records through visible extension tools.\",\"profile\":\"copilot\",\"tags\":[\"records\",\"record\"],\"capabilities\":[\"record-store\",\"record-search\",\"extension-tools\"],\"representativeQueries\":[\"remember this for later\",\"search my saved records\",\"list records MCP tools\"],\"required_capabilities\":[{\"name\":\"db:read\",\"scope\":\"records\"}],\"body\":\"# Records Record\\n\\nUse this skill when an agent needs to store, list, or search records through a visible Records extension.\\n\\nUse `/mcp/v1/extensions/records` or `/mcp/v1/extensions/profiles/copilot` only when the same Antfly identity can discover the Records MCP tools.\\n\\nDo not infer access to records or record tools that are not visible through the caller's Antfly identity.\\n\"}"
      },
      {
        "kind": "agent",
        "name": "research",
        "shape": "search_records_request",
        "config_json": "{\"displayName\":\"Records Research Agent\",\"description\":\"Plan and answer with visible Records records.\",\"profile\":\"copilot\",\"protocols\":[\"agents-api\",\"mcp-tool\",\"stream\"],\"tags\":[\"records\",\"record\",\"research\"],\"capabilities\":[\"record-search\",\"record-research\",\"extension-agent\"],\"representativeQueries\":[\"research from my saved records\",\"summarize relevant records\"],\"required_capabilities\":[{\"name\":\"db:read\",\"scope\":\"records\"}],\"handler\":\"wasm:records_wasm/research\",\"stream_handler\":\"wasm:records_wasm/research_stream\"}"
      },
      {
        "kind": "mcp_tool",
        "name": "store_record",
        "shape": "store_record_request",
        "config_json": "{\"runtime\":\"records_wasm\",\"handler\":\"wasm:records_wasm/store_record\",\"required_capabilities\":[{\"name\":\"db:write\",\"scope\":\"records\"},{\"name\":\"ai:embed\",\"scope\":\"records\"}]}"
      },
      {
        "kind": "mcp_tool",
        "name": "search_records",
        "shape": "search_records_request",
        "config_json": "{\"runtime\":\"records_wasm\",\"handler\":\"wasm:records_wasm/search_records\",\"required_capabilities\":[{\"name\":\"db:read\",\"scope\":\"records\"}]}"
      },
      {
        "kind": "mcp_tool",
        "name": "list_records",
        "shape": "list_records_request",
        "config_json": "{\"runtime\":\"records_wasm\",\"handler\":\"wasm:records_wasm/list_records\",\"required_capabilities\":[{\"name\":\"db:read\",\"scope\":\"records\"}]}"
      }
    ],
    "runtimes": [
      {
        "name": "records_wasm",
        "mode": "wasm",
        "artifact": "target/wasm32-wasip2/release/records_extension.wasm",
        "config_json": "{\"abi\":\"antfly-extension/v1\",\"entrypoint\":\"call-tool\",\"wit\":\"wit/antfly-extension.wit\"}"
      }
    ],
    "config_schema_json": "{\"type\":\"object\",\"properties\":{\"default_project\":{\"type\":\"string\"},\"default_visibility\":{\"type\":\"string\",\"enum\":[\"team\",\"private\"]},\"embedding_model\":{\"type\":\"string\"},\"ephemeral_ttl\":{\"type\":\"string\"}}}"
  }
}
