==== positive tier=fast
CONSTANTS
    BuggyOlderStatusWins = FALSE
    BuggyRemovedOwnerWins = FALSE
    BuggyCrossRootDiskReuse = FALSE
    BuggyUnknownZeroIsKnown = FALSE
    BuggyPartialJoinStats = FALSE
    BuggyPartialSchemaFinalize = FALSE
    BuggyStaleSchemaProgress = FALSE
    BuggyDropOldReadSchema = FALSE
SPECIFICATION Spec
INVARIANTS
    NewerAuthoritativeStatusIsStable
    RemovedOwnersAreIgnored
    KnownDiskFactsMatchStorageRoot
    JoinUsesCompleteFreshFacts
    SchemaFinalizesWithCompleteCurrentCoverage
    ReadSchemaAvailableOnEveryServingReplica

==== heavy-liveness tier=heavy
CONSTANTS
    BuggyOlderStatusWins = FALSE
    BuggyRemovedOwnerWins = FALSE
    BuggyCrossRootDiskReuse = FALSE
    BuggyUnknownZeroIsKnown = FALSE
    BuggyPartialJoinStats = FALSE
    BuggyPartialSchemaFinalize = FALSE
    BuggyStaleSchemaProgress = FALSE
    BuggyDropOldReadSchema = FALSE
SPECIFICATION FairSpec
PROPERTY MigrationEventuallyFinalizes

