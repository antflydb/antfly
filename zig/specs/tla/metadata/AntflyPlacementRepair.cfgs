==== positive tier=fast
CONSTANTS
    BuggyLoadSensitive = FALSE
    BuggyRenumber = FALSE
    BuggyCombineRebalance = FALSE
    BuggyDuplicateIds = FALSE
    BuggyDropAdvancedDuplicate = FALSE
    BuggyRelatchFinal = FALSE
    BuggyAcceptWrongStore = FALSE
    BuggyAcceptWrongSet = FALSE
    BuggyAcceptNonLeader = FALSE
    BuggyPrematureRetire = FALSE
    BuggyWaitForAllFollowers = FALSE
SPECIFICATION Spec
INVARIANTS
    ReplacementTargetLatched
    SurvivorReplicaIdentityPreserved
    MandatoryRepairIsSerialized
    DeclaredReplicaIdsUnique
    AdvancedDuplicateIsRetained
    PlacementCountPreserved
    FinalMembershipIsLatched
    AcceptedProofIsAuthoritative
    SourceRetirementRequiresFinalLeaderProof

