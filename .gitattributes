# Bundled Antfarm assets contain upstream template literals where trailing
# spaces are semantically part of shader/diagram source. Do not make generated
# bundles fail the repository whitespace gate.
zig/pkg/antfly/antfarm/assets/*.js whitespace=-trailing-space

# PDF fixtures are binary test assets; xref entries contain required padding.
*.pdf binary

# Raw video fixture bytes can resemble text; preserve and review them as binary.
zig/lib/video/testdata/*.yuv binary
zig/lib/video/testdata/*.rgba binary

zig/lib/video/testdata/vpx-av1/*.ivf binary
zig/lib/video/testdata/vpx-av1/*.webm binary
# GLiNER family captures and CUDA artifacts are generated qualification data.
zig/pkg/inference/testdata/gliner25/family/evidence/** linguist-generated=true
zig/pkg/inference/testdata/gliner25/family/*/oracle_fp32.jsonl linguist-generated=true
zig/pkg/inference/testdata/gliner25/family/*/capacity_oracle_fp32.jsonl linguist-generated=true
zig/pkg/inference/src/ops/cuda/artifacts/inference_cuda_kernels.ptx linguist-generated=true

# Pinned compression dictionaries and packed grammar tables are binary assets.
zig/lib/compress/src/brotli/brotli_dictionary.bin binary
zig/lib/syntax/src/grammars/*.bin binary

# CLI tooling and benchmark evidence are generated artifacts; keep source diffs readable.
zig/pkg/antfly-grep/generated/** linguist-generated=true
zig/pkg/antfly-grep/bench/results/** linguist-generated=true

# OCR timing samples and captured benchmark logs are generated evidence.
zig/pkg/inference/scripts/lightonocr3/results/throughput_parity_m4_max/** linguist-generated=true
zig/pkg/inference/scripts/lightonocr3/results/throughput_parity_m4_max/README.md linguist-generated=false

zig/pkg/inference/scripts/lightonocr3/results/throughput_recurrent_m4_max/** linguist-generated=true
zig/pkg/inference/scripts/lightonocr3/results/throughput_recurrent_m4_max/README.md linguist-generated=false

zig/pkg/inference/scripts/lightonocr3/results/throughput_pipeline_m4_max/** linguist-generated=true
zig/pkg/inference/scripts/lightonocr3/results/throughput_pipeline_m4_max/README.md linguist-generated=false
zig/pkg/inference/scripts/lightonocr3/results/throughput_epoch_m4_max/** linguist-generated=true
zig/pkg/inference/scripts/lightonocr3/results/throughput_epoch_m4_max/README.md linguist-generated=false
zig/pkg/inference/scripts/lightonocr3/results/throughput_engine_m4_max/** linguist-generated=true
zig/pkg/inference/scripts/lightonocr3/results/throughput_engine_m4_max/README.md linguist-generated=false
