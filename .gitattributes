# Bundled Antfarm assets contain upstream template literals where trailing
# spaces are semantically part of shader/diagram source. Do not make generated
# bundles fail the repository whitespace gate.
zig/pkg/antfly/antfarm/assets/*.js whitespace=-trailing-space

# PDF fixtures are binary test assets; xref entries contain required padding.
*.pdf binary

# Raw video fixture bytes can resemble text; preserve and review them as binary.
zig/lib/video/testdata/*.yuv binary
zig/lib/video/testdata/*.rgba binary
